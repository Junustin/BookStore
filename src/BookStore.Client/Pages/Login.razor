@page "/login"
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-12">
    <MudCard Elevation="4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5">BookStore POS Sign In</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />
                <MudTextField Label="Username" @bind-Value="_loginModel.Username" Variant="Variant.Outlined" Class="mb-4" />
                <MudTextField Label="Password" InputType="InputType.Password" @bind-Value="_loginModel.Password" Variant="Variant.Outlined" Class="mb-4" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="_loading">
                    @if (_loading)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Authenticating...</MudText>
                    }
                    else
                    {
                        <MudText>Sign In</MudText>
                    }
                </MudButton>
            </EditForm>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private LoginRequest _loginModel = new();
    private bool _loading;

    private async Task HandleLogin()
    {
        _loading = true;
        try
        {
            // Submit credentials to backend Minimal API
            var response = await Http.PostAsJsonAsync("api/auth/login", _loginModel);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LoginResponse>();
                if (result?.Token is not null)
                {
                    // Cast injected provider to access custom state mutation method
                    var customAuth = (CustomAuthStateProvider)AuthStateProvider;
                    
                    // Persist JWT to localStorage and signal UI re-render
                    await customAuth.NotifyUserAuthenticationAsync(result.Token);
                    
                    Snackbar.Add("Authentication successful", Severity.Success);
                    Navigation.NavigateTo("/");
                }
            }
            else
            {
                Snackbar.Add("Invalid username or password.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Login failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    public class LoginRequest
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    public class LoginResponse
    {
        public string Token { get; set; } = string.Empty;
    }
}